# ============================================
# Patrebna Environment Configuration
# ============================================

# === MongoDB ===
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=

# === Redis ===
REDIS_PASSWORD=

# === Telegram ===
TELEGRAM_BOT_TOKEN=
#ID чата/канала куда бот отправляет уведомления администратору:
#  - Когда новый пользователь присоединился
#  - Когда пользователь удалён
#(Опционально, можно оставить пустым)
TELEGRAM_CHAT_ID=

# === Server ===
# HOST - домен с https:// (например: https://example.com)
# Не нужен если USE_TUNNEL=true
HOST=
WEBHOOK_PORT=8443

# === Cloudflare Tunnel ===
# true - использовать cloudflared домен для webhook. После запуска контейнера автоматически будет получен и установлен домен для работы телеграм через webhook
# false - использовать webhook с сертификатами и своим доменом установленным в переменной HOST
# Пример запуска с туннелем: docker-compose --profile tunnel up -d
USE_TUNNEL=false

# === bePaid (Payment, optional) ===
STORE_ID=
BEPAID_API_KEY=

# === CRON === (Например каждые 30 секунд)
CRON_SCHEDULE_FREE='*/30 * * * * *'